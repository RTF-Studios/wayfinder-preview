{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtf:lesson-content:1.0",
  "title": "M1 source-derived lesson payload (not a curriculum registry)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "identity": {
      "type": "object",
      "properties": {
        "course": {
          "enum": [
            "Tech",
            "CS",
            "AAVTC"
          ]
        },
        "dayid": {
          "type": "string",
          "pattern": "^[123][0-9]{6}$"
        },
        "unit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "part": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "course",
        "dayid",
        "unit",
        "part",
        "day",
        "title"
      ],
      "additionalProperties": false
    },
    "mode": {
      "enum": [
        "STARTER",
        "LEARN",
        "PERFORM",
        "ASSESSMENT"
      ]
    },
    "learningTarget": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "what": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text",
        "what",
        "why"
      ],
      "additionalProperties": false
    },
    "teks": {
      "type": "object",
      "properties": {
        "priority": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "wording": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "wording"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "supporting": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "applicable"
                  ]
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 1
                      },
                      "wording": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "code",
                      "wording"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "status",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "priority",
        "supporting"
      ],
      "additionalProperties": false
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "term",
          "definition"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 4
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "available": {
            "const": true
          },
          "access": {
            "enum": [
              "installed",
              "district_accessible",
              "offline"
            ]
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "available",
          "access",
          "instructions"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "applicable"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "status",
              "title",
              "text",
              "steps"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "not_applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "status",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sectionId": {
            "type": "string",
            "minLength": 1
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "sectionId",
          "instructions",
          "outcome"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "evidence": {
      "type": "object",
      "properties": {
        "graded": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "applicable"
                  ]
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/question"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "status",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        },
        "xtra": {
          "type": "object",
          "properties": {
            "warmUp": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "applicable"
                      ]
                    },
                    "fullKey": {
                      "type": "string",
                      "pattern": "^[123][0-9]{11}$"
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "submissionUrl": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "status",
                    "fullKey",
                    "prompt",
                    "submissionUrl"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "not_applicable"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "temperature": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "applicable"
                      ]
                    },
                    "fullKey": {
                      "type": "string",
                      "pattern": "^[123][0-9]{11}$"
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "submissionUrl": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "status",
                    "fullKey",
                    "prompt",
                    "submissionUrl"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "not_applicable"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "studio": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "applicable"
                      ]
                    },
                    "fullKey": {
                      "type": "string",
                      "pattern": "^[123][0-9]{11}$"
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "submissionUrl": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "status",
                    "fullKey",
                    "prompt",
                    "submissionUrl"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "not_applicable"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "warmUp",
            "temperature",
            "studio"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "graded",
        "xtra"
      ],
      "additionalProperties": false
    },
    "pacing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sectionId": {
            "type": "string",
            "minLength": 1
          },
          "minutes": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "sectionId",
          "minutes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "media": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "applicable"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/media"
              },
              "minItems": 1
            }
          },
          "required": [
            "status",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "not_applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "presentation": {
      "type": "object",
      "properties": {
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "studioIdeas": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "applicable"
                  ]
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "instructions": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "title",
                      "instructions"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "status",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "notes",
        "studioIdeas"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "mode",
    "learningTarget",
    "teks",
    "vocabulary",
    "tools",
    "sections",
    "activities",
    "evidence",
    "pacing",
    "media",
    "presentation"
  ],
  "additionalProperties": false,
  "$defs": {
    "part": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "answerType": {
          "enum": [
            "selected_choice",
            "multiple_choice",
            "checkbox",
            "short_text",
            "fill_blank",
            "dropdown",
            "true_false",
            "comparison_diagram_response"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "acceptedAnswers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "scoringCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "independentlyScored": {
          "const": true
        },
        "stimulusIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "sentence": {
          "type": "string"
        },
        "blanks": {
          "type": "integer",
          "minimum": 0
        },
        "help": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "prompt",
        "answerType",
        "options",
        "acceptedAnswers",
        "scoringCriteria",
        "independentlyScored",
        "stimulusIds",
        "sentence",
        "blanks",
        "help"
      ],
      "additionalProperties": false
    },
    "rubric": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "minimum": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "maximum": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "name",
              "minimum",
              "maximum",
              "criteria"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "text",
        "bands"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "fullKey": {
          "type": "string",
          "pattern": "^[123][0-9]{11}$"
        },
        "category": {
          "enum": [
            "DAILY",
            "MAJOR"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          },
          "minItems": 1
        },
        "rubric": {
          "$ref": "#/$defs/rubric"
        },
        "pinnedSource": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "reference",
            "revision"
          ],
          "additionalProperties": false
        },
        "submissionUrl": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "fullKey",
        "category",
        "title",
        "prompt",
        "parts",
        "rubric",
        "pinnedSource",
        "submissionUrl"
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "image",
            "diagram",
            "code",
            "text",
            "document",
            "video",
            "audio"
          ]
        },
        "purpose": {
          "enum": [
            "target",
            "exemplar",
            "warm",
            "studio",
            "comic"
          ]
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "enum": [
            "image/webp",
            "image/svg+xml",
            "text/plain",
            "application/pdf",
            "video/mp4",
            "audio/mpeg"
          ]
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "rightsApproved": {
          "const": true
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "offlineEmbedded": {
          "const": true
        },
        "dataUri": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "purpose",
        "sourceReference",
        "mimeType",
        "alt",
        "rightsApproved",
        "attribution",
        "offlineEmbedded",
        "dataUri"
      ],
      "additionalProperties": false
    }
  }
}
